# Copy this file to .env and fill in your real credentials. .env is
# gitignored — never commit your actual secrets.

# Alpaca paper trading account API credentials.
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Telegram bot token (from @BotFather) and the target chat ID to notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
